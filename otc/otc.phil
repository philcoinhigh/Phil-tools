// Phil OTC desk: a token listing that can be filled in parts.
//
// The maker locks tokens with the desk at a price per token. Round by round
// the taker buys some, or passes. The listing ends when it is sold out, when
// it expires, or when the maker cancels after a fill. Tokens and cash are
// linear values, so on every one of those paths each coin ends with exactly
// one owner: the desk cannot keep, copy or lose one.

record Token mode linear {
  amount : U64
}

record Cash mode linear {
  amount : U64
}

// Cut `part` tokens off the listing. The desk can never hand out more than it holds.
callable Carve(book : Token, part : U64) -> (Token, Token) {
  requires part > 0;
  requires part <= book.amount;
  outcomes { success (Token, Token) };
}

fn carve(book : Token, part : U64) -> (Token, Token) satisfies Carve {
  let Token { amount = total } = book;
  return (construct Token { amount = part }, construct Token { amount = total - part });
}

// An empty listing may be retired. A listing that still holds tokens may not.
callable Retire(book : Token) -> U64 {
  requires book.amount == 0;
  outcomes { success U64 };
}

fn retire(book : Token) -> U64 satisfies Retire {
  let Token { amount } = book;
  return amount;
}

// The desk only settles a payment that matches the amount due exactly.
callable Settle(payment : Cash, due : U64) -> Cash {
  requires payment.amount == due;
  outcomes { success Cash };
}

fn settle(payment : Cash, due : U64) -> Cash satisfies Settle {
  return payment;
}

// The fee is in basis points (100 = 1%) and capped at 10%, so the cut is
// always smaller than the payment and the multiplication cannot overflow.
callable TakeFee(payment : Cash, fee_bps : U64) -> (Cash, Cash) {
  requires fee_bps <= 1000;
  requires payment.amount <= 1000000000000000;
  outcomes { success (Cash, Cash) };
}

fn take_fee(payment : Cash, fee_bps : U64) -> (Cash, Cash) satisfies TakeFee {
  let Cash { amount = total } = payment;
  let cut = total * fee_bps / 10000;
  return (construct Cash { amount = total - cut }, construct Cash { amount = cut });
}

callable Pay(wallet : Cash, due : U64) -> (Cash, Cash) {
  requires due <= wallet.amount;
  outcomes { success (Cash, Cash) };
}

fn pay(wallet : Cash, due : U64) -> (Cash, Cash) satisfies Pay {
  let Cash { amount = total } = wallet;
  return (construct Cash { amount = due }, construct Cash { amount = total - due });
}

callable Smaller(a : U64, b : U64) -> U64 {
  outcomes { success U64 };
}

fn smaller(a : U64, b : U64) -> U64 satisfies Smaller {
  if le(a, b) {
    return a;
  } else {
    return b;
  };
}

// Maker and desk. After every fill the maker may keep the listing open or cancel it.
protocol Listing {
  role Maker = send (unit_price : U64) then send (tokens : Token) then recursive Book = offer {
    Filled => receive (proceeds : Cash) then select {
      Keep => continue Book |
      Cancel => receive (rest : Token) then end Cancelled
    } |
    Expired => receive (rest : Token) then end Expired |
    SoldOut => end SoldOut
  };
  role Desk = receive (unit_price : U64) then receive (tokens : Token) then recursive Book = select {
    Filled => send (proceeds : Cash) then offer {
      Keep => continue Book |
      Cancel => send (rest : Token) then end Cancelled
    } |
    Expired => send (rest : Token) then end Expired |
    SoldOut => end SoldOut
  };
}

// Desk and taker. Each round the desk quotes what is left; the taker buys some or passes.
protocol Deal {
  role Desk = recursive Round = select {
    Open => send (available : U64) then send (unit_price : U64) then offer {
      Buy => receive (want : U64) then receive (payment : Cash) then send (tokens : Token) then continue Round |
      Pass => continue Round
    } |
    Closed => end Closed
  };
  role Taker = recursive Round = offer {
    Open => receive (available : U64) then receive (unit_price : U64) then select {
      Buy => send (want : U64) then send (payment : Cash) then receive (tokens : Token) then continue Round |
      Pass => continue Round
    } |
    Closed => end Closed
  };
}

component Maker(
  desk : Maker[Listing],
  selling : {v : U64 | v <= 1000000},
  unit_price : {v : U64 | v <= 1000000000},
  cancel_after : U64
) provides U64 {
  let quoted = send unit_price on desk;
  let locked = send construct Token { amount = selling } on quoted;
  let earned = loop state (ep = locked, fills : U64 = 0, got : U64 = 0) {
    offer ep {
      Filled => {
        let (asked, proceeds) = receive Cash on ep;
        let Cash { amount = cash } = proceeds;
        if eq(fills + 1, cancel_after) {
          let cancelled = select Cancel on asked;
          let (done, rest) = receive Token on cancelled;
          close done;
          let Token { amount = back } = rest;
          console_write("maker cancelled and got tokens back:", back);
          break (got + cash);
        } else {
          let kept = select Keep on asked;
          continue (kept, fills + 1, got + cash);
        };
      }
      Expired => {
        let (done, rest) = receive Token on ep;
        close done;
        let Token { amount = back } = rest;
        console_write("listing expired, maker got tokens back:", back);
        break (got);
      }
      SoldOut => {
        close ep;
        console_write("listing sold out");
        break (got);
      }
    };
  };
  return earned;
}

component Taker(desk : Taker[Deal], want : U64, wallet : U64) provides U64 {
  let bought = loop state (ep = desk, cash = construct Cash { amount = wallet }, have : U64 = 0) {
    offer ep {
      Open => {
        let (e1, available) = receive U64 on ep;
        let (e2, unit_price) = receive U64 on e1;
        let take = smaller(want, available);
        let due = take * unit_price;
        let funds = borrow cash as c { return c.amount; };
        if gt(take, 0) {
          if ge(funds, due) {
            let (payment, change) = pay(cash, due);
            let buying = select Buy on e2;
            let sized = send take on buying;
            let paid = send payment on sized;
            let (next, tokens) = receive Token on paid;
            let Token { amount = got } = tokens;
            continue (next, change, have + got);
          } else {
            let next = select Pass on e2;
            continue (next, cash, have);
          };
        } else {
          let next = select Pass on e2;
          continue (next, cash, have);
        };
      }
      Closed => {
        close ep;
        let Cash { amount = left } = cash;
        console_write("taker holds", have, "tokens and", left, "cash");
        break (have);
      }
    };
  };
  return bought;
}

component Desk(
  maker : Desk[Listing],
  taker : Desk[Deal],
  fee_bps : {v : U64 | v <= 1000},
  expires_after : {v : U64 | v <= 100}
) provides U64 {
  let (m1, unit_price) = receive U64 on maker;
  let (m2, tokens) = receive Token on m1;
  let fees = loop state (m = m2, t = taker, book = tokens, round : U64 = 0, earned : U64 = 0) {
    let available = borrow book as b { return b.amount; };
    if eq(available, 0) {
      let t_done = select Closed on t;
      close t_done;
      let m_done = select SoldOut on m;
      close m_done;
      let none = retire(book);
      break (earned);
    } else {
      if ge(round, expires_after) {
        let t_done = select Closed on t;
        close t_done;
        let m_exp = select Expired on m;
        let m_done = send book on m_exp;
        close m_done;
        break (earned);
      } else {
        let t1 = select Open on t;
        let t2 = send available on t1;
        let t3 = send unit_price on t2;
        offer t3 {
          Buy => {
            let (t4, want) = receive U64 on t3;
            let (t5, payment) = receive Cash on t4;
            let checked = settle(payment, want * unit_price);
            let (out, rest) = carve(book, want);
            let t6 = send out on t5;
            let (proceeds, cut) = take_fee(checked, fee_bps);
            let Cash { amount = kept } = cut;
            let m3 = select Filled on m;
            let m4 = send proceeds on m3;
            offer m4 {
              Keep => {
                continue (m4, t6, rest, round + 1, earned + kept);
              }
              Cancel => {
                let m_done = send rest on m4;
                close m_done;
                let t_done = select Closed on t6;
                close t_done;
                break (earned + kept);
              }
            };
          }
          Pass => {
            continue (m, t3, book, round + 1, earned);
          }
        };
      };
    };
  };
  console_write("desk fees:", fees);
  return fees;
}

architecture OtcDesk {
  instance maker = Maker;
  instance taker = Taker;
  instance desk = Desk;
  process maker_run = maker;
  process taker_run = taker;
  process desk_run = desk;
  protocol listing = Listing;
  protocol deal = Deal;
  role listing.Maker = maker;
  role listing.Desk = desk;
  role deal.Desk = desk;
  role deal.Taker = taker;
  entry selling : U64;
  entry unit_price : U64;
  entry want : U64;
  entry wallet : U64;
  entry fee_bps : U64;
  entry expires_after : U64;
  entry cancel_after : U64;
  bind maker.desk = listing.Maker;
  bind maker.selling = selling;
  bind maker.unit_price = unit_price;
  bind maker.cancel_after = cancel_after;
  bind taker.desk = deal.Taker;
  bind taker.want = want;
  bind taker.wallet = wallet;
  bind desk.maker = listing.Desk;
  bind desk.taker = deal.Desk;
  bind desk.fee_bps = fee_bps;
  bind desk.expires_after = expires_after;
}

program main = instantiate OtcDesk;
